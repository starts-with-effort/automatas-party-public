# Copiar como .env y completar. El archivo .env no se sube al repositorio.

# Token secreto del panel /host (mínimo 128 bits). Generarlo con: openssl rand -hex 32
HOST_TOKEN=

# Token de la presentación (/slides y /remote), distinto del del host. Mismo formato:
# openssl rand -hex 32. Ver docs/PRESENTACION.md.
SLIDES_TOKEN=

# URL pública que va en el QR. En la VM: https://tu-dominio.example
# Si se deja vacía, se usa la dirección con la que se abrió el proyector.
PUBLIC_URL=

# Dónde escucha Node. En la VM: 127.0.0.1 (solo Caddy llega a Node).
# En tu PC: 0.0.0.0 para probar con celulares conectados al mismo WiFi.
HOST=127.0.0.1
PORT=3000
